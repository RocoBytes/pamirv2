# Copia este archivo a .env y rellena tus valores
# Render.com inyecta estas variables directamente — .env solo es necesario en local

# ── Base de datos ─────────────────────────────────────────────────────────────
# Neon.tech — usa el endpoint pooled (-pooler.) para Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto del servidor (Render.com asigna PORT automáticamente en producción)
PORT=3001

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT de sesión.
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL pública del backend (necesaria para los links de verificación en emails)
# Ejemplo en Render.com: https://pamir-api.onrender.com
BACKEND_URL="https://your-api.onrender.com"

# ── Google (OAuth2 con Refresh Token) ────────────────────────────────────────
# El código usa OAuth2, NO Service Account. Uso exclusivo de Google Drive (los
# correos ya NO pasan por Gmail — ver sección "Correo por club" más abajo).
# 1. Ve a Google Cloud Console → APIs & Services → Credentials
# 2. Crea un OAuth 2.0 Client ID (tipo "Web application")
# 3. Obtén el refresh_token usando OAuth Playground: https://developers.google.com/oauthplayground
#    Scope requerido:
#      - https://www.googleapis.com/auth/drive.file   (subida de archivos GPX)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# Respaldo. Desde el panel de administración (sección "Credencial de Google") se
# puede pegar un token nuevo, que se guarda cifrado en la base y tiene prioridad
# sobre esta variable. Con la pantalla de consentimiento OAuth en estado
# "Testing", Google caduca el refresh token cada 7 días.
GOOGLE_REFRESH_TOKEN="YOUR_GOOGLE_REFRESH_TOKEN"

# ID de la carpeta de Google Drive donde se guardarán los archivos GPX.
# Extráelo de la URL de Drive: drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID="YOUR_GOOGLE_DRIVE_FOLDER_ID"

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL del frontend en Vercel (sin trailing slash). En desarrollo no es necesaria.
# Ejemplo: https://pamir.vercel.app
FRONTEND_URL="https://your-app.vercel.app"

# URLs adicionales permitidas por CORS (separadas por coma, sin espacios).
# Úsalo para añadir preview deployments específicos de Vercel, en lugar del wildcard *.vercel.app.
# Ejemplo: https://pamir-pr-42.vercel.app,https://pamir-feature-xyz.vercel.app
ADDITIONAL_ORIGINS=""

# ── Correo por club (proveedor transaccional) ────────────────────────────────
# Cada club envía sus correos con SU propio nombre y responde a SU propio
# contacto (Organization.name / Organization.contactEmail, no una variable de
# entorno) — ver sección "Correo por club" en el README para el detalle
# completo. La DIRECCIÓN remitente, en cambio, no depende del club: es una de
# dos direcciones fijas según el tipo de correo (MAIL_FROM_* más abajo).

# "smtp" (producción) o "console" (solo registra en el log, nunca envía).
# Si se omite: se usa "smtp" cuando hay SMTP_HOST, si no "console".
# "console" nunca está permitido con NODE_ENV=production (fail-fast).
EMAIL_PROVIDER="console"

# Servidor SMTP propio (nunca un proveedor externo). Puerto 587 exige
# STARTTLS obligatorio; puerto 465 usa TLS implícito desde el primer byte.
# Las cuatro son requeridas cuando EMAIL_PROVIDER=smtp o cuando no se define
# EMAIL_PROVIDER en producción.
SMTP_HOST="smtp.riala.cl"
SMTP_PORT="587"
SMTP_USER="usuario@riala.cl"
SMTP_PASS=""

# Direcciones remitentes fijas por tipo de correo (nunca por club ni por
# actividad). Ambas deben existir como casilla o alias en el servidor SMTP de
# arriba (ahí llegan los rebotes) y esa cuenta debe estar autorizada a enviar
# como cada una. Un valor vacío o en blanco cae al default mostrado acá; uno
# presente pero inválido detiene el arranque.
MAIL_FROM_NOTIFICACIONES="notificaciones@riala.cl"
MAIL_FROM_ALERTAS="alertas@riala.cl"

# El destinatario de la alarma de seguridad del cron (salida sin cierre) es el
# alertEmail de CADA club (columna Organization.alertEmail, no una variable de
# entorno): no tiene relación con el panel de administración.
#
# Esta variable es solo para desarrollo: redirige TODAS las alarmas del cron a
# una casilla de pruebas, sin importar el club de la salida. En producción
# (NODE_ENV=production) se IGNORA siempre — a propósito, para que un valor
# olvidado en el entorno no desvíe en silencio la alarma de seguridad de un
# club hacia una sola casilla.
DEV_ALERT_EMAIL_OVERRIDE=""

# Agregar con openssl rand -hex 32
CRON_SECRET="Agregar"
