# Variables de entorno del backend.
# En produccion viven en /opt/pamir/.env (chmod 600) del VPS, y el
# contenedor las recibe por env_file desde deploy/docker-compose.yml.
# En desarrollo, copia este archivo a .env y completa los valores.

# ── Base de datos ─────────────────────────────────────────────────────────────
# Neon.tech — usa el endpoint pooled (-pooler.) para Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Los scripts que pueden tocar la base de datos (db:create-user, tenant:*,
# test:isolation) comparan DATABASE_URL contra backend/db-target.json y abortan
# si no coincide, para que un comando local no toque por accidente otra base
# de datos (ver "Protección de la base de datos" en el README). El contenedor
# de producción no tiene ese archivo ni tsx: ahí, y SOLO ahí, se saltea la
# guardia con ALLOW_ANY_DB_TARGET=1 al invocar el script ya compilado
# (docker compose exec -e ALLOW_ANY_DB_TARGET=1 backend node dist/scripts/...).
# Nunca lo definas en desarrollo: anularía la única protección contra correr
# un comando de escritura sobre la base de datos equivocada.
# ALLOW_ANY_DB_TARGET=1

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto del servidor (Render.com asigna PORT automáticamente en producción)
PORT=3001

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT de sesión.
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL pública del backend (necesaria para los links de verificación en emails)
# Ejemplo en Render.com: https://pamir-api.onrender.com
BACKEND_URL="https://your-api.onrender.com"

# ── Almacenamiento de archivos (Google Cloud Storage) ────────────────────────
# GPX, pronósticos, documentos de la biblioteca e itinerarios adjuntos se
# suben directo a un bucket privado (nunca a disco: el contenedor es
# read_only). Las URLs de descarga se firman bajo demanda (10 minutos) — el
# bucket nunca debe ser público.
#
# "gcs" (producción) o "memory" (solo en memoria del proceso, se pierde al
# reiniciar). Si se omite: se usa "gcs" cuando hay GCS_BUCKET, si no "memory".
# "memory" nunca está permitido con NODE_ENV=production (fail-fast).
STORAGE_PROVIDER="memory"

# Nombre del bucket de GCS. Requerido cuando el proveedor resuelto es "gcs".
GCS_BUCKET="YOUR_GCS_BUCKET"

# ID del proyecto de Google Cloud dueño del bucket.
GCS_PROJECT_ID="YOUR_GCS_PROJECT_ID"

# Llave de una cuenta de servicio con permiso de lectura/escritura sobre el
# bucket (rol "Storage Object Admin" alcanza al bucket, no al proyecto),
# codificada en base64. Se guarda SIEMPRE fuera del repositorio.
# Generarla:
#   1. Crea la cuenta de servicio y descarga su llave JSON desde
#      Google Cloud Console → IAM & Admin → Service Accounts.
#   2. Codifícala: base64 < llave.json | tr -d '\n'
GCS_CREDENTIALS_JSON="YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_KEY"

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL pública del frontend (sin barra final), usada tanto para el allowlist de
# CORS (app.ts) como para construir los links de los correos y del CLI de
# clubes (verificación, invitaciones, evaluaciones, eventos — ver
# lib/config.ts). En blanco o sin definir cae al valor por defecto de
# desarrollo (http://localhost:5173); en producción es OBLIGATORIA (ver el
# chequeo fail-fast de src/index.ts) — un valor en blanco ahí nunca debe
# terminar mandando un correo real con un link a localhost.
# Ejemplo: https://tu-dominio.example
FRONTEND_URL="https://tu-dominio.example"

# URLs adicionales permitidas por CORS (separadas por coma, sin espacios).
# Úsalo para añadir preview deployments específicos de Vercel, en lugar del wildcard *.vercel.app.
# Ejemplo: https://pamir-pr-42.vercel.app,https://pamir-feature-xyz.vercel.app
ADDITIONAL_ORIGINS=""

# ── Correo por club (proveedor transaccional) ────────────────────────────────
# Cada club envía sus correos con SU propio nombre y responde a SU propio
# contacto (Organization.name / Organization.contactEmail, no una variable de
# entorno) — ver sección "Correo por club" en el README para el detalle
# completo. La DIRECCIÓN remitente, en cambio, no depende del club: es una de
# dos direcciones fijas según el tipo de correo (MAIL_FROM_* más abajo).

# "smtp" (producción) o "console" (solo registra en el log, nunca envía).
# Si se omite: se usa "smtp" cuando hay SMTP_HOST, si no "console".
# "console" nunca está permitido con NODE_ENV=production (fail-fast).
EMAIL_PROVIDER="console"

# Servidor SMTP propio (nunca un proveedor externo). Puerto 587 exige
# STARTTLS obligatorio; puerto 465 usa TLS implícito desde el primer byte.
# Las cuatro son requeridas cuando EMAIL_PROVIDER=smtp o cuando no se define
# EMAIL_PROVIDER en producción.
SMTP_HOST="smtp.riala.cl"
SMTP_PORT="587"
SMTP_USER="usuario@riala.cl"
SMTP_PASS=""

# Direcciones remitentes fijas por tipo de correo (nunca por club ni por
# actividad). Ambas deben existir como casilla o alias en el servidor SMTP de
# arriba (ahí llegan los rebotes) y esa cuenta debe estar autorizada a enviar
# como cada una. Un valor vacío o en blanco cae al default mostrado acá; uno
# presente pero inválido detiene el arranque.
MAIL_FROM_NOTIFICACIONES="notificaciones@riala.cl"
MAIL_FROM_ALERTAS="alertas@riala.cl"

# Credenciales SMTP PROPIAS de cada tipo de correo — opcionales, sobrescriben
# SMTP_USER/SMTP_PASS solo para ese tipo. Existen porque un servidor SMTP que
# impone "sender ownership" rechaza en RCPT TO cualquier envío autenticado con
# una cuenta que no es dueña de la dirección remitente, con un error como:
#   553 5.7.1 <alertas@riala.cl>: Sender address rejected: not owned by user
#   notificaciones@riala.cl
# Si el servidor propio hace esto, cada dirección de MAIL_FROM_* de arriba
# necesita autenticarse con SU PROPIA cuenta en vez de la cuenta global única.
# Ambas variables de un mismo par deben definirse juntas — definir solo una
# mitad detiene el arranque nombrando la que falta. Si un tipo no define su
# par, cae al SMTP_USER/SMTP_PASS global de arriba.
SMTP_USER_NOTIFICACIONES=""
SMTP_PASS_NOTIFICACIONES=""
SMTP_USER_ALERTAS=""
SMTP_PASS_ALERTAS=""

# El destinatario de la alarma de seguridad del cron (salida sin cierre) es el
# alertEmail de CADA club (columna Organization.alertEmail, no una variable de
# entorno): no tiene relación con el panel de administración.
#
# Esta variable es solo para desarrollo: redirige TODAS las alarmas del cron a
# una casilla de pruebas, sin importar el club de la salida. En producción
# (NODE_ENV=production) se IGNORA siempre — a propósito, para que un valor
# olvidado en el entorno no desvíe en silencio la alarma de seguridad de un
# club hacia una sola casilla.
DEV_ALERT_EMAIL_OVERRIDE=""

# Agregar con openssl rand -hex 32
CRON_SECRET="Agregar"
